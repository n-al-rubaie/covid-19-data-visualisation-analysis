      <aliases enabled='yes' />
      <column caption='*Overall Global Average Cumulative Cases' datatype='real' name='[Calculation_468092913395695626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Cumulative_cases]))&#13;&#10; / COUNT([Date_reported])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='*Average Cumulative Cases per Day by Country' datatype='real' name='[Calculation_468092913397927947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Cumulative_cases]) / COUNTD([Date_reported])' />
